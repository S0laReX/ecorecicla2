# Template only. Store real values in Render Environment or an ignored .env.production.
NODE_ENV=production
HOST=0.0.0.0
# Render supplies PORT. Do not copy the MySQL port into PORT.
TRUST_PROXY_HOPS=1
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Set according to the MySQL endpoint's TLS support. Certificate verification stays enabled.
DB_SSL=false
# DB_SSL_CA_PATH=/etc/secrets/mysql-ca.pem
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=/etc/secrets/jwt-private.pem
JWT_ISSUER=ecorecicla-auth
JWT_AUDIENCE=ecorecicla-api
FRONTEND_ORIGIN=https://YOUR_FRONTEND_DOMAIN
RECOVERY_DELIVERY=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
