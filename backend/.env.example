PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecorecicla
DB_USER=ecorecicla_app
DB_PASSWORD=
# RSA public key in PEM, with literal \n separators. No signing key in this service.
JWT_PUBLIC_KEY=
JWT_ISSUER=ecorecicla-auth
JWT_AUDIENCE=ecorecicla-api
JWT_PRIVATE_KEY_PATH=.keys/jwt-private.pem
FRONTEND_ORIGIN=http://localhost:3000
# local writes recovery links to .local/recovery; use smtp in production.
RECOVERY_DELIVERY=local
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
