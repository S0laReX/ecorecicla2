{
  "name": "ecorecicla-api-foundation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env scripts/migrate.cjs",
    "setup:local": "node scripts/setup-local.cjs",
    "seed:admin": "node --env-file=.env scripts/seed-admin.cjs",
    "test:integration": "node --env-file=.env test/integration.mysql.cjs",
    "test:collections": "node --env-file=.env test/collections.mysql.cjs",
    "test:reservations": "node --env-file=.env test/reservations.mysql.cjs",
    "test:confirmation": "node --env-file=.env test/confirmation.mysql.cjs",
    "test:ratings": "node --env-file=.env test/ratings.mysql.cjs",
    "test:admin-accounts": "node --env-file=.env test/adminAccounts.mysql.cjs",
    "test:material-points": "node --env-file=.env test/materialPoints.mysql.cjs",
    "test:notices": "node --env-file=.env test/notices.mysql.cjs",
    "test:profile": "node --env-file=.env test/profile.mysql.cjs",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p jsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.8.0"
  }
}
